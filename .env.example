# Copy this file to .env.development (and .env.production) and fill in your own values:
#   cp .env.example .env.development
#
# ⚠️ Never commit real values. Every .env* file except this one is git-ignored.
# Note: VITE_* variables are bundled into the client JS, so never put a true
# server-side secret here.

# Backend API
VITE_API_BASE_URL=https://api.example.com

# Google OAuth (Google Cloud Console → Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign In (Apple Developer → Service IDs)
VITE_APPLE_CLIENT_ID=com.example.web
VITE_APPLE_REDIRECT_URI=http://localhost:5173/auth/apple/callback

# Amplitude analytics (leave empty to disable tracking locally)
VITE_AMPLITUDE_API_KEY=
